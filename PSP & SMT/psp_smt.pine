//@version=6

indicator("PSP & SMT Divergence [Mayya]", shorttitle="PSP & SMT [Mayya]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=1000)

// # ========================================================================= #
// # |   Constants & Style Helpers   |
// # ========================================================================= #

//#region Constants & Helpers
color_c_green       = #089981
color_c_red         = #f23645
color_transparent   = #ffffff00

f_line_style(string s) =>
    switch s
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

f_label_size(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.normal

f_short_name(string sym) =>
    arr = str.split(sym, ":")
    arr.get(arr.size() - 1)
//#endregion

// # ========================================================================= #
// # |   Inputs: Correlated Symbols (3 Slots Maksimal)   |
// # ========================================================================= #

//#region Correlated Symbols
g_sym         = "📊 Simbol Korelasi (Maks. 3 Pair - Otomatis Ikut Timeframe Chart)"

// Slot 1
enable_s1     = input.bool(true, "Aktif", inline = "s1", group = g_sym)
sym1          = input.symbol("CME_MINI:NQ1!", "Pair 1", inline = "s1", group = g_sym)
inv1          = input.bool(false, "Inverse", inline = "s1", group = g_sym, tooltip = "Balikkan pergerakan harga untuk aset yang berkorelasi negatif (seperti DXY)")

// Slot 2
enable_s2     = input.bool(true, "Aktif", inline = "s2", group = g_sym)
sym2          = input.symbol("CME_MINI:ES1!", "Pair 2", inline = "s2", group = g_sym)
inv2          = input.bool(false, "Inverse", inline = "s2", group = g_sym)

// Slot 3
enable_s3     = input.bool(false, "Aktif", inline = "s3", group = g_sym)
sym3          = input.symbol("CBOT_MINI:YM1!", "Pair 3", inline = "s3", group = g_sym)
inv3          = input.bool(false, "Inverse", inline = "s3", group = g_sym)

s1_name = f_short_name(sym1)
s2_name = f_short_name(sym2)
s3_name = f_short_name(sym3)
//#endregion

// # ========================================================================= #
// # |   Inputs: SMT Divergence Settings   |
// # ========================================================================= #

//#region SMT Settings
g_smt              = "⚡ SMT Divergence (Smart Money Technique)"
smt_show           = input.bool(true, "Aktifkan Garis SMT", group = g_smt)
smt_line_color     = input.color(color_c_red, "Warna Garis SMT", inline = "smt_l", group = g_smt)
smt_line_style_str = input.string("Solid", "Gaya Garis", options = ["Solid", "Dashed", "Dotted"], inline = "smt_l", group = g_smt)
smt_line_width     = input.int(2, "Lebar", minval = 1, maxval = 4, inline = "smt_l", group = g_smt)

smt_left           = input.int(2, "Swing Lookback (Kiri)", minval = 1, maxval = 10, inline = "smt_sw", group = g_smt, tooltip = "Jumlah bar di sebelah kiri untuk mendeteksi swing pivot (Default 2 untuk mendeteksi struktur 3-5 bar fractal)")
smt_right          = input.int(1, "Konfirmasi (Kanan)", minval = 1, maxval = 5, inline = "smt_sw", group = g_smt, tooltip = "Jumlah bar di sebelah kanan untuk konfirmasi swing pivot (Default 1)")
smt_min_bars       = input.int(2, "Min. Jarak Bar", minval = 1, maxval = 10, inline = "smt_dist", group = g_smt, tooltip = "Jarak minimum candle antar kedua swing point agar tidak bertumpuk")
smt_max_bars       = input.int(40, "Maks. Jarak Bar", minval = 5, maxval = 100, inline = "smt_dist", group = g_smt, tooltip = "Jarak maksimum candle antar kedua swing point untuk relevansi struktur market")
smt_max_lines      = input.int(3, "Maksimum Garis", minval = 1, maxval = 10, group = g_smt, tooltip = "Batasi jumlah garis di chart agar tetap bersih dan fokus pada SMT terkini")

smt_lbl_show       = input.bool(true, "Tampilkan Label SMT", inline = "smt_lbl", group = g_smt)
smt_lbl_size_str   = input.string("Normal", "Ukuran", options = ["Tiny", "Small", "Normal", "Large"], inline = "smt_lbl", group = g_smt)
smt_lbl_color      = input.color(color_c_red, "Warna Teks", inline = "smt_lbl_c", group = g_smt)
smt_lbl_bg         = input.color(color_transparent, "Background", inline = "smt_lbl_c", group = g_smt)

smt_line_style     = f_line_style(smt_line_style_str)
smt_lbl_size       = f_label_size(smt_lbl_size_str)
//#endregion

// # ========================================================================= #
// # |   Inputs: Price Symmetry Pivot (PSP) Settings   |
// # ========================================================================= #

//#region PSP Settings
g_psp              = "🕯️ Price Symmetry Pivot (PSP)"
psp_show           = input.bool(true, "Aktifkan Pewarnaan Candle PSP", group = g_psp)
psp_bull_color     = input.color(color_c_green, "Warna Bullish PSP", inline = "psp_col", group = g_psp)
psp_bear_color     = input.color(color_c_red,   "Warna Bearish PSP", inline = "psp_col", group = g_psp)
//#endregion


// # ========================================================================= #
// # |   Data Hub: Fetch Correlated Pairs (100% Mengikuti Timeframe Chart)   |
// # ========================================================================= #

//#region Data Fetching
// Menggunakan timeframe "" menjamin data korelasi selalu 100% identik dengan timeframe chart aktif (1m, 5m, 1h, 4h, Daily, dll.)
[t_o1, t_h1, t_l1, t_c1] = request.security(enable_s1 ? sym1 : syminfo.tickerid, "", [open, high, low, close], lookahead = barmerge.lookahead_off)
raw_o1 = enable_s1 ? t_o1 : float(na)
raw_h1 = enable_s1 ? t_h1 : float(na)
raw_l1 = enable_s1 ? t_l1 : float(na)
raw_c1 = enable_s1 ? t_c1 : float(na)

[t_o2, t_h2, t_l2, t_c2] = request.security(enable_s2 ? sym2 : syminfo.tickerid, "", [open, high, low, close], lookahead = barmerge.lookahead_off)
raw_o2 = enable_s2 ? t_o2 : float(na)
raw_h2 = enable_s2 ? t_h2 : float(na)
raw_l2 = enable_s2 ? t_l2 : float(na)
raw_c2 = enable_s2 ? t_c2 : float(na)

[t_o3, t_h3, t_l3, t_c3] = request.security(enable_s3 ? sym3 : syminfo.tickerid, "", [open, high, low, close], lookahead = barmerge.lookahead_off)
raw_o3 = enable_s3 ? t_o3 : float(na)
raw_h3 = enable_s3 ? t_h3 : float(na)
raw_l3 = enable_s3 ? t_l3 : float(na)
raw_c3 = enable_s3 ? t_c3 : float(na)

// Handle Inverse transformation
s1_O = inv1 ? -raw_c1 : raw_o1
s1_H = inv1 ? -raw_l1 : raw_h1
s1_L = inv1 ? -raw_h1 : raw_l1
s1_C = inv1 ? -raw_o1 : raw_c1

s2_O = inv2 ? -raw_c2 : raw_o2
s2_H = inv2 ? -raw_l2 : raw_h2
s2_L = inv2 ? -raw_h2 : raw_l2
s2_C = inv2 ? -raw_o2 : raw_c2

s3_O = inv3 ? -raw_c3 : raw_o3
s3_H = inv3 ? -raw_l3 : raw_h3
s3_L = inv3 ? -raw_h3 : raw_l3
s3_C = inv3 ? -raw_o3 : raw_c3
//#endregion

// # ========================================================================= #
// # |   PSP Engine: Candle Divergence Detection   |
// # ========================================================================= #

//#region PSP Logic
bool psp_bull_s1 = enable_s1 and not na(s1_C) and (close > open) and (s1_C < s1_O)
bool psp_bull_s2 = enable_s2 and not na(s2_C) and (close > open) and (s2_C < s2_O)
bool psp_bull_s3 = enable_s3 and not na(s3_C) and (close > open) and (s3_C < s3_O)
bool is_psp_bull = psp_bull_s1 or psp_bull_s2 or psp_bull_s3

bool psp_bear_s1 = enable_s1 and not na(s1_C) and (close < open) and (s1_C > s1_O)
bool psp_bear_s2 = enable_s2 and not na(s2_C) and (close < open) and (s2_C > s2_O)
bool psp_bear_s3 = enable_s3 and not na(s3_C) and (close < open) and (s3_C > s3_O)
bool is_psp_bear = psp_bear_s1 or psp_bear_s2 or psp_bear_s3

// Terapkan Pewarnaan Candle PSP (Default: Hijau Bullish, Merah Bearish)
color psp_color = na
if psp_show
    if is_psp_bull
        psp_color := psp_bull_color
    else if is_psp_bear
        psp_color := psp_bear_color

barcolor(psp_color, title = "Warna Candle PSP")
//#endregion

// # ========================================================================= #
// # |   SMT Engine: Precision Structural Swing Divergence & Direct Pair Label |
// # ========================================================================= #

//#region SMT Logic
// Deteksi Swing Point menggunakan ta.pivotlow dan ta.pivothigh pada timeframe chart aktif
float pl_pivot = ta.pivotlow(low, smt_left, smt_right)
float ph_pivot = ta.pivothigh(high, smt_left, smt_right)

bool is_swing_low  = not na(pl_pivot)
bool is_swing_high = not na(ph_pivot)

int p_offset = smt_right

// Fungsi pembaca harga ekstrim korelasi (dengan toleransi ±1 bar agar akurat menangkap ujung wick)
f_corr_low(float src, int off) =>
    math.min(src[off], math.min(src[off + 1], src[math.max(0, off - 1)]))

f_corr_high(float src, int off) =>
    math.max(src[off], math.max(src[off + 1], src[math.max(0, off - 1)]))

// Variabel memori Major Swing Low
var float major_low_price   = na
var int   major_low_time    = na
var int   major_low_bar     = na
var float major_low_s1      = na
var float major_low_s2      = na
var float major_low_s3      = na

// Variabel memori Major Swing High
var float major_high_price  = na
var int   major_high_time   = na
var int   major_high_bar    = na
var float major_high_s1     = na
var float major_high_s2     = na
var float major_high_s3     = na

// Array storage visual lines & labels
var line[]  smt_lines_arr  = array.new_line()
var label[] smt_labels_arr = array.new_label()

// ── Evaluasi SMT Bullish (Major Swing Low Divergence) ─────────
bool is_smt_bull = false
string bull_pair_txt = ""

if is_swing_low and smt_show
    float curr_low_price = low[p_offset]
    int   curr_low_time  = time[p_offset]
    int   curr_low_bar   = bar_index[p_offset]
    float curr_s1_low    = f_corr_low(s1_L, p_offset)
    float curr_s2_low    = f_corr_low(s2_L, p_offset)
    float curr_s3_low    = f_corr_low(s3_L, p_offset)
    
    // Syarat SMC Presisi: Harus ada Major Swing High (Puncak) di antara kedua Swing Low (Lembah)!
    bool has_intervening_high = not na(major_high_bar) and (major_high_bar > major_low_bar)
    
    if not na(major_low_price) and has_intervening_high
        int bar_distance = curr_low_bar - major_low_bar
        if bar_distance >= smt_min_bars and bar_distance <= smt_max_bars
            bool s1_div = false
            bool s2_div = false
            bool s3_div = false
            
            // Slot 1: Evaluasi divergensi terhadap Major Swing Low sebelumnya
            if enable_s1 and not na(major_low_s1) and not na(curr_s1_low)
                // Kasus 1 (Sweep): Chart Utama Lower Low, Correlated Pair Higher Low
                // Kasus 2 (Holding): Chart Utama Higher Low, Correlated Pair Lower Low
                if (curr_low_price < major_low_price and curr_s1_low > major_low_s1) or (curr_low_price > major_low_price and curr_s1_low < major_low_s1)
                    s1_div := true
            
            // Slot 2
            if enable_s2 and not na(major_low_s2) and not na(curr_s2_low)
                if (curr_low_price < major_low_price and curr_s2_low > major_low_s2) or (curr_low_price > major_low_price and curr_s2_low < major_low_s2)
                    s2_div := true
            
            // Slot 3
            if enable_s3 and not na(major_low_s3) and not na(curr_s3_low)
                if (curr_low_price < major_low_price and curr_s3_low > major_low_s3) or (curr_low_price > major_low_price and curr_s3_low < major_low_s3)
                    s3_div := true
            
            if s1_div or s2_div or s3_div
                is_smt_bull := true
                
                // Rangkai nama pair korelasi murni
                if s1_div
                    bull_pair_txt := s1_name
                if s2_div
                    bull_pair_txt := bull_pair_txt == "" ? s2_name : bull_pair_txt + " & " + s2_name
                if s3_div
                    bull_pair_txt := bull_pair_txt == "" ? s3_name : bull_pair_txt + " & " + s3_name
                
                // Buat garis SMT tepat menghubungkan kedua wick major swing low
                line l_smt = line.new(x1 = major_low_time, y1 = major_low_price,
                                      x2 = curr_low_time, y2 = curr_low_price,
                                      xloc = xloc.bar_time, color = smt_line_color,
                                      width = smt_line_width, style = smt_line_style)
                
                // Label tepat di tengah garis dengan nama pair korelasi
                int   mid_x = int(math.avg(major_low_time, curr_low_time))
                float mid_y = math.avg(major_low_price, curr_low_price)
                
                label l_lbl = smt_lbl_show ? label.new(x = mid_x, y = mid_y, text = bull_pair_txt,
                                                        xloc = xloc.bar_time, color = smt_lbl_bg,
                                                        textcolor = smt_lbl_color, style = label.style_label_center,
                                                        size = smt_lbl_size) : na
                
                array.push(smt_lines_arr, l_smt)
                if not na(l_lbl)
                    array.push(smt_labels_arr, l_lbl)
                
                while array.size(smt_lines_arr) > smt_max_lines
                    line.delete(array.shift(smt_lines_arr))
                while array.size(smt_labels_arr) > smt_max_lines
                    label.delete(array.shift(smt_labels_arr))
    
    // Perbarui state Major Swing Low
    if na(major_low_price) or has_intervening_high
        major_low_price := curr_low_price
        major_low_time  := curr_low_time
        major_low_bar   := curr_low_bar
        major_low_s1    := curr_s1_low
        major_low_s2    := curr_s2_low
        major_low_s3    := curr_s3_low
    else if curr_low_price < major_low_price
        major_low_price := curr_low_price
        major_low_time  := curr_low_time
        major_low_bar   := curr_low_bar
        major_low_s1    := curr_s1_low
        major_low_s2    := curr_s2_low
        major_low_s3    := curr_s3_low


// ── Evaluasi SMT Bearish (Major Swing High Divergence) ────────
bool is_smt_bear = false
string bear_pair_txt = ""

if is_swing_high and smt_show
    float curr_high_price = high[p_offset]
    int   curr_high_time  = time[p_offset]
    int   curr_high_bar   = bar_index[p_offset]
    float curr_s1_high    = f_corr_high(s1_H, p_offset)
    float curr_s2_high    = f_corr_high(s2_H, p_offset)
    float curr_s3_high    = f_corr_high(s3_H, p_offset)
    
    // Syarat SMC Presisi: Harus ada Major Swing Low (Lembah) di antara kedua Swing High (Puncak)!
    bool has_intervening_low = not na(major_low_bar) and (major_low_bar > major_high_bar)
    
    if not na(major_high_price) and has_intervening_low
        int bar_distance = curr_high_bar - major_high_bar
        if bar_distance >= smt_min_bars and bar_distance <= smt_max_bars
            bool s1_div = false
            bool s2_div = false
            bool s3_div = false
            
            // Slot 1
            if enable_s1 and not na(major_high_s1) and not na(curr_s1_high)
                if (curr_high_price > major_high_price and curr_s1_high < major_high_s1) or (curr_high_price < major_high_price and curr_s1_high > major_high_s1)
                    s1_div := true
            
            // Slot 2
            if enable_s2 and not na(major_high_s2) and not na(curr_s2_high)
                if (curr_high_price > major_high_price and curr_s2_high < major_high_s2) or (curr_high_price < major_high_price and curr_s2_high > major_high_s2)
                    s2_div := true
            
            // Slot 3
            if enable_s3 and not na(major_high_s3) and not na(curr_s3_high)
                if (curr_high_price > major_high_price and curr_s3_high < major_high_s3) or (curr_high_price < major_high_price and curr_s3_high > major_high_s3)
                    s3_div := true
            
            if s1_div or s2_div or s3_div
                is_smt_bear := true
                
                if s1_div
                    bear_pair_txt := s1_name
                if s2_div
                    bear_pair_txt := bear_pair_txt == "" ? s2_name : bear_pair_txt + " & " + s2_name
                if s3_div
                    bear_pair_txt := bear_pair_txt == "" ? s3_name : bear_pair_txt + " & " + s3_name
                
                line l_smt = line.new(x1 = major_high_time, y1 = major_high_price,
                                      x2 = curr_high_time, y2 = curr_high_price,
                                      xloc = xloc.bar_time, color = smt_line_color,
                                      width = smt_line_width, style = smt_line_style)
                
                int   mid_x = int(math.avg(major_high_time, curr_high_time))
                float mid_y = math.avg(major_high_price, curr_high_price)
                
                label l_lbl = smt_lbl_show ? label.new(x = mid_x, y = mid_y, text = bear_pair_txt,
                                                        xloc = xloc.bar_time, color = smt_lbl_bg,
                                                        textcolor = smt_lbl_color, style = label.style_label_center,
                                                        size = smt_lbl_size) : na
                
                array.push(smt_lines_arr, l_smt)
                if not na(l_lbl)
                    array.push(smt_labels_arr, l_lbl)
                
                while array.size(smt_lines_arr) > smt_max_lines
                    line.delete(array.shift(smt_lines_arr))
                while array.size(smt_labels_arr) > smt_max_lines
                    label.delete(array.shift(smt_labels_arr))
    
    if na(major_high_price) or has_intervening_low
        major_high_price := curr_high_price
        major_high_time  := curr_high_time
        major_high_bar   := curr_high_bar
        major_high_s1    := curr_s1_high
        major_high_s2    := curr_s2_high
        major_high_s3    := curr_s3_high
    else if curr_high_price > major_high_price
        major_high_price := curr_high_price
        major_high_time  := curr_high_time
        major_high_bar   := curr_high_bar
        major_high_s1    := curr_s1_high
        major_high_s2    := curr_s2_high
        major_high_s3    := curr_s3_high
//#endregion


// # ========================================================================= #
// # |   Alerts   |
// # ========================================================================= #

//#region Alerts
alertcondition(is_smt_bull, "Bullish SMT Divergence", "🟢 Bullish SMT Divergence terdeteksi pada {{ticker}}!")
alertcondition(is_smt_bear, "Bearish SMT Divergence", "🔴 Bearish SMT Divergence terdeteksi pada {{ticker}}!")
alertcondition(is_psp_bull, "Bullish PSP Candle",     "🟢 Bullish PSP Candle terdeteksi pada {{ticker}}!")
alertcondition(is_psp_bear, "Bearish PSP Candle",     "🔴 Bearish PSP Candle terdeteksi pada {{ticker}}!")
//#endregion