htf_sweeps_tf_1_map                         = input.bool(false, "M", inline = "1.0", group = "Timeframes", tooltip = "Map this HTF to LTF")
htf_sweeps_tf_1_tf                          = f_tf_to_res(htf_sweeps_tf_1_input)

