htf_2_number            = input.int(4, "", minval = 1, maxval = 30, inline = "htf2", group = g_htf)
htf_2_map               = input.bool(false, "Trace LTF", inline = "htf2", group = g_htf)

htf_3_show              = input.bool(true, "HTF III   ", inline = "htf3", group = g_htf)
htf_3_tf                = input.timeframe("1D", "", inline = "htf3", group = g_htf)
htf_3_number            = input.int(3, "", minval = 1, maxval = 30, inline = "htf3", group = g_htf)
htf_3_map               = input.bool(false, "Trace LTF", inline = "htf3", group = g_htf)

htf_title_position      = input.string("Top", "Posisi Title Timeframe", options = ["Both", "Top", "Bottom"], group = g_htf, tooltip = "Pilih posisi label title timeframe: Di Atas (Top), Di Bawah (Bottom), atau Keduanya (Both)")
htf_countdown_show      = input.bool(true, "Waktu Mundur Close Candle", group = g_htf, tooltip = "Tampilkan hitung mundur waktu close candle di bawah title")
