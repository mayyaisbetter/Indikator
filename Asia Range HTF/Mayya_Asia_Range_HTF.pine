    res := str.replace_all(res, "n", "𝗻")
    res := str.replace_all(res, "o", "𝗼")
    res := str.replace_all(res, "p", "𝗽")
    res := str.replace_all(res, "q", "𝗾")
    res := str.replace_all(res, "r", "𝗿")
    res := str.replace_all(res, "s", "𝘀")
    res := str.replace_all(res, "t", "𝘁")
    res := str.replace_all(res, "u", "𝘂")
    res := str.replace_all(res, "v", "𝘃")
    res := str.replace_all(res, "w", "𝘄")
    res := str.replace_all(res, "x", "𝘅")
    res := str.replace_all(res, "y", "𝘆")
    res := str.replace_all(res, "z", "𝘇")
    res := str.replace_all(res, "A", "𝗔")
    res := str.replace_all(res, "B", "𝗕")
    res := str.replace_all(res, "C", "𝗖")
    res := str.replace_all(res, "D", "𝗗")
    res := str.replace_all(res, "E", "𝗘")
    res := str.replace_all(res, "F", "𝗙")
    res := str.replace_all(res, "G", "𝗚")
    res := str.replace_all(res, "H", "𝗛")
    res := str.replace_all(res, "I", "𝗜")
    res := str.replace_all(res, "J", "𝗝")
    res := str.replace_all(res, "K", "𝗞")
    res := str.replace_all(res, "L", "𝗟")
    res := str.replace_all(res, "M", "𝗠")
    res := str.replace_all(res, "N", "𝗡")
    res := str.replace_all(res, "O", "𝗢")
    res := str.replace_all(res, "P", "𝗣")
    res := str.replace_all(res, "Q", "𝗤")
    res := str.replace_all(res, "R", "𝗥")
    res := str.replace_all(res, "S", "𝗦")
    res := str.replace_all(res, "T", "𝗧")
    res := str.replace_all(res, "U", "𝗨")
    res := str.replace_all(res, "V", "𝗩")
    res := str.replace_all(res, "W", "𝗪")
    res := str.replace_all(res, "X", "𝗫")
    res := str.replace_all(res, "Y", "𝗬")
