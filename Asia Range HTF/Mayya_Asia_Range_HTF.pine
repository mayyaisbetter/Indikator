// # HTF Timeframe Mapping Helper ------------------------------------------- #
f_tf_to_res(string tf_str) =>
    switch tf_str
        '15m' => '15'
        '30m' => '30'
        '45m' => '45'
        '1h'  => '60'
        '90m' => '90'
        '2h'  => '120'
        '3h'  => '180'
        '4h'  => '240'
        '6h'  => '360'
        '7h'  => '420'
        '8h'  => '480'
        '9h'  => '540'
        '12h' => '720'
        '1D'  => '1D'
        '1W'  => '1W'
        '1M'  => '1M'
        => tf_str

// # Timeframes (HTF Candle) ------------------------------------------------- #
htf_sweeps_tf_1_show   = input.bool(true, "HTF I     ", inline = "1.0", group = "Timeframes")
htf_sweeps_tf_1_input  = input.string("15m", "", inline = "1.0", group = "Timeframes", options = ['15m', '30m', '45m', '1h', '90m', '2h', '3h', '4h', '6h', '7h', '8h', '9h', '12h', '1D', '1W', '1M'])
htf_sweeps_tf_1_number = input.int(10, "", inline = "1.0", group = "Timeframes", minval = 1, maxval = 10)
htf_sweeps_tf_1_tf     = f_tf_to_res(htf_sweeps_tf_1_input)

htf_sweeps_tf_2_show   = input.bool(true, "HTF II    ", inline = "2.0", group = "Timeframes")
htf_sweeps_tf_2_input  = input.string("1h", "", inline = "2.0", group = "Timeframes", options = ['15m', '30m', '45m', '1h', '90m', '2h', '3h', '4h', '6h', '7h', '8h', '9h', '12h', '1D', '1W', '1M'])
htf_sweeps_tf_2_number = input.int(8, "", inline = "2.0", group = "Timeframes", minval = 1, maxval = 10)
htf_sweeps_tf_2_tf     = f_tf_to_res(htf_sweeps_tf_2_input)

htf_sweeps_tf_3_show   = input.bool(true, "HTF III   ", inline = "3.0", group = "Timeframes")
htf_sweeps_tf_3_input  = input.string("4h", "", inline = "3.0", group = "Timeframes", options = ['15m', '30m', '45m', '1h', '90m', '2h', '3h', '4h', '6h', '7h', '8h', '9h', '12h', '1D', '1W', '1M'])
htf_sweeps_tf_3_number = input.int(6, "", inline = "3.0", group = "Timeframes", minval = 1, maxval = 10)
htf_sweeps_tf_3_tf     = f_tf_to_res(htf_sweeps_tf_3_input)

