asia_show_eq            = input.bool(true, "Garis 50% Equilibrium (EQ)", group = g_asia)
asia_eq_col             = input.color(color.new(color.gray, 30), "Warna EQ", group = g_asia)
asia_extend_bars        = input.int(50, "Panjang Ekstensi Garis (Bar)", minval = 5, maxval = 300, group = g_asia, tooltip = "Berapa bar garis High/Low/EQ diekstensi ke depan setelah sesi Asia tutup")
asia_detect_sweep       = input.bool(true, "Deteksi Liquidity Sweep Asia", group = g_asia, tooltip = "Tampilkan sinyal saat London atau NY menyapu High/Low Asia")
asia_history_count      = input.int(5, "Jumlah History Sesi Asia", minval = 1, maxval = 20, group = g_asia)

// --- Modul HTF Candles ---
g_htf                   = "HTF Candles Settings"
