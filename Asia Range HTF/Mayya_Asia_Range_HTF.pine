        => 'UTC'

var string tz = f_parse_tz(i_tz)
//#endregion

// # ========================================================================= #
// # |   HTF Candle Logic & Drawing   |
// # ========================================================================= #

//#region HTF Rendering
method add_htf_candle(array<UDT_HTF_Candle> htf_candles, UDT_HTF_Candle candle, int total_candles_number) =>
    if not na(candle)
        if htf_candles.size() >= total_candles_number
            htf_candles.pop()
        htf_candles.unshift(candle)
    htf_candles

method detect_htf_candle(array<UDT_HTF_Candle> htf_candles, string tf) =>
    UDT_HTF_Candle htf_candle = na
    bool is_new = session_begins(tf, "", na) or htf_candles.size() == 0
    if is_new
        UDT_HTF_Candle candle = UDT_HTF_Candle.new(tf = tf)
        candle.o     := open
        candle.c     := close
        candle.h     := high
        candle.l     := low
        candle.o_idx := bar_index
        candle.c_idx := bar_index
        candle.h_idx := bar_index
        candle.l_idx := bar_index
        candle.ot    := time
        candle.bull  := is_bullish_candle(candle.c, candle.o, candle.h, candle.l)
        if htf_candles.size() > 0
            UDT_HTF_Candle last_candle = htf_candles.get(0)
            last_candle.is_closed := true
            last_candle.ct        := time
        htf_candle := candle
    
    if not is_new and in_session(tf, "", na) and htf_candles.size() > 0
        UDT_HTF_Candle candle = htf_candles.get(0)
        candle.c     := close
        candle.c_idx := bar_index + 1
        candle.ct    := time
        if high > candle.h
            candle.h     := high
            candle.h_idx := bar_index
        if low < candle.l
            candle.l     := low
            candle.l_idx := bar_index 
        candle.bull  := is_bullish_candle(candle.c, candle.o, candle.h, candle.l)
    
    htf_candle

get_htf_candle_shift(int candle_index, int offset, int buffer, int width, int candles_amount) =>
    offset + (width + buffer) * (candles_amount - candle_index - 1)

method position_htf_candle(UDT_HTF_Candle candle, int candle_index, int offset, int buffer, int width, int candles_amount) => 
    candle.shift         := get_htf_candle_shift(candle_index, offset, buffer, width, candles_amount)
    candle.candle_left   := last_bar_index + candle.shift
    candle.candle_right  := candle.candle_left + width
    candle.candle_top    := math.max(candle.o, candle.c)
    candle.candle_bottom := math.min(candle.o, candle.c)
    candle.wick_x        := candle.candle_left + int(math.round(width / 2.0))
    candle

method position_htf_candles(array<UDT_HTF_Candle> htf_candles, int shift, int buffer, int width) =>
    int candles_amount = htf_candles.size()
    for [index, candle] in htf_candles
        candle.position_htf_candle(index, shift, buffer, width, candles_amount)

method draw_htf_candle(UDT_HTF_Candle candle) =>
    color candle_color = candle.bull ? htf_sweeps_bull_color : htf_sweeps_bear_color    
    bin.bin_box.push(box.new(left=candle.candle_left, top=candle.candle_top, right=candle.candle_right, bottom=candle.candle_bottom, border_color = htf_sweeps_wick_border_color, border_width = 1, bgcolor = candle_color))
    bin.bin_ln.push(line.new(x1=candle.wick_x, y1=candle.h, x2=candle.wick_x, y2=candle.candle_top, color = htf_sweeps_wick_border_color))
    bin.bin_ln.push(line.new(x1=candle.wick_x, y1=candle.candle_bottom, x2=candle.wick_x, y2=candle.l, color = htf_sweeps_wick_border_color))
    candle

method draw_htf_label(array<UDT_HTF_Candle> htf_candles, string tf) =>
    float y_top    = na
    float y_bottom = na
    int   x_min    = na
    int   x_max    = na
    for [index, candle] in htf_candles
        switch htf_sweeps_label_position
            "Both"   =>
                y_top    := na(y_top)    ? candle.h : math.max(y_top, candle.h)
                y_bottom := na(y_bottom) ? candle.l : math.min(y_bottom, candle.l)
            "Top"    => 
                y_top    := na(y_top)    ? candle.h : math.max(y_top, candle.h)
            "Bottom" => 
                y_bottom := na(y_bottom) ? candle.l : math.min(y_bottom, candle.l)
        x_min := na(x_min) ? candle.wick_x : math.min(x_min, candle.wick_x)
        x_max := na(x_max) ? candle.wick_x : math.max(x_max, candle.wick_x)

    int x = math.round(math.avg(x_min, x_max))
    string txt = format_text_style(tf_label(tf), general_font)

    if htf_sweeps_countdown_show
        int tc     = time_close(tf)
        int tf_sec = timeframe.in_seconds(tf)
        int tf_ms  = tf_sec * 1000

        // Fallback akurat jika time_close na atau tertinggal (delay <= timenow)
        if (na(tc) or tc <= timenow) and tf_ms > 0
            if htf_candles.size() > 0
                UDT_HTF_Candle curr_candle = htf_candles.get(0)
                if not na(curr_candle.ot)
                    tc := curr_candle.ot + tf_ms
                    if tc <= timenow
                        int elapsed = timenow - curr_candle.ot
                        tc := curr_candle.ot + (math.floor(elapsed / tf_ms) + 1) * tf_ms
            if na(tc) or tc <= timenow
                tc := time + tf_ms

        if not na(tc)
            int rem = math.max(0, tc - timenow)
            txt := txt + "\n" + format_text_style(format_countdown(rem), general_font)

    if not na(y_top)
        bin.bin_lbl.push(label.new(x = x, y = y_top, text = txt, tooltip = str.format("HTF {0}", tf_label(tf)), xloc=xloc.bar_index, color=color_transparent, style=label.style_label_down, textcolor=htf_sweeps_label_color, size=f_text_size(htf_sweeps_label_size), text_font_family=f_font_style(general_font)))
    if not na(y_bottom)
        bin.bin_lbl.push(label.new(x = x, y = y_bottom, text = txt, tooltip = str.format("HTF {0}", tf_label(tf)), xloc=xloc.bar_index, color=color_transparent, style=label.style_label_up, textcolor=htf_sweeps_label_color, size=f_text_size(htf_sweeps_label_size), text_font_family=f_font_style(general_font)))

    htf_candles

method draw_htf_fvg(array<UDT_HTF_Candle> htf_candles) =>
    if htf_fvg_show and htf_candles.size() >= 3
        int count = htf_candles.size()
        // Iterasi dari candle tertua ke terdekat (dari count - 2 down to 1)
        for i = count - 2 to 1
            UDT_HTF_Candle c1 = htf_candles.get(i + 1)
            UDT_HTF_Candle c2 = htf_candles.get(i)
            UDT_HTF_Candle c3 = htf_candles.get(i - 1)

            bool is_bull_fvg = c3.l > c1.h
            bool is_bear_fvg = c3.h < c1.l

            if is_bull_fvg or is_bear_fvg
                float top_y = is_bull_fvg ? c3.l : c1.l
                float bot_y = is_bull_fvg ? c1.h : c3.h

                // Cek mitigasi jika opsi hanya unmitigated diaktifkan
                bool is_mitigated = false
                if not htf_fvg_mitigated and i > 1
                    for j = i - 2 to 0
                        UDT_HTF_Candle c_sub = htf_candles.get(j)
                        if is_bull_fvg and c_sub.l <= bot_y
                            is_mitigated := true
                            break
                        if is_bear_fvg and c_sub.h >= top_y
                            is_mitigated := true
                            break

                if not is_mitigated
                    int left_x   = c1.candle_left
                    int right_x  = htf_fvg_extend ? htf_candles.get(0).candle_right : c3.candle_right
                    color bg_col = is_bull_fvg ? htf_fvg_bull_color : htf_fvg_bear_color
                    color b_col  = htf_fvg_border_show ? htf_fvg_border_color : color_transparent
                    int bw       = htf_fvg_border_show ? 1 : 0
                    bin.bin_box.push(box.new(left = left_x, top = top_y, right = right_x, bottom = bot_y, bgcolor = bg_col, border_color = b_col, border_width = bw))
    htf_candles

method plot_htf(array<UDT_HTF_Candle> htf_candles, string tf) =>
    if htf_fvg_show
        htf_candles.draw_htf_fvg()
    for [index, candle] in htf_candles
        candle.draw_htf_candle()
    if htf_sweeps_label_show and htf_candles.size() > 0
        htf_candles.draw_htf_label(tf)
    htf_candles

f_render_htf(array<UDT_HTF_Candle> candles, string tf, int max_n, bool show, int current_offset, int space, int width) =>
    int new_offset = current_offset
    if show
        candles.position_htf_candles(current_offset, space, width)
        candles.plot_htf(tf)
        new_offset += get_htf_candle_shift(0, htf_sweeps_offset, space, width, max_n)
    new_offset
//#endregion

// # ========================================================================= #
// # |   HTF Candle Execution   |
// # ========================================================================= #

//#region HTF Execution
var htf_1_candles = array.new<UDT_HTF_Candle>()
var htf_2_candles = array.new<UDT_HTF_Candle>()
var htf_3_candles = array.new<UDT_HTF_Candle>()

var int htf_candle_width = candle_size(htf_sweeps_candle_width)

var bool tf_1_show = htf_sweeps_tf_1_show and timeframe.in_seconds(timeframe.period) < timeframe.in_seconds(htf_sweeps_tf_1_tf)
var bool tf_2_show = htf_sweeps_tf_2_show and timeframe.in_seconds(timeframe.period) < timeframe.in_seconds(htf_sweeps_tf_2_tf)
var bool tf_3_show = htf_sweeps_tf_3_show and timeframe.in_seconds(timeframe.period) < timeframe.in_seconds(htf_sweeps_tf_3_tf)

if showHTFCandle
    if tf_1_show
        htf_1_candles.add_htf_candle(htf_1_candles.detect_htf_candle(htf_sweeps_tf_1_tf), htf_sweeps_tf_1_number)
    if tf_2_show
        htf_2_candles.add_htf_candle(htf_2_candles.detect_htf_candle(htf_sweeps_tf_2_tf), htf_sweeps_tf_2_number)
    if tf_3_show
        htf_3_candles.add_htf_candle(htf_3_candles.detect_htf_candle(htf_sweeps_tf_3_tf), htf_sweeps_tf_3_number)
    
    // Render objek visual HANYA saat barstate.islast untuk performa optimal
    if barstate.islast
        bin.clean_bin()
        int offset = htf_sweeps_offset
        offset := f_render_htf(htf_1_candles, htf_sweeps_tf_1_tf, htf_sweeps_tf_1_number, tf_1_show, offset, htf_sweeps_space, htf_candle_width)
        offset := f_render_htf(htf_2_candles, htf_sweeps_tf_2_tf, htf_sweeps_tf_2_number, tf_2_show, offset, htf_sweeps_space, htf_candle_width)
        offset := f_render_htf(htf_3_candles, htf_sweeps_tf_3_tf, htf_sweeps_tf_3_number, tf_3_show, offset, htf_sweeps_space, htf_candle_width)
else if barstate.islast
    bin.clean_bin()
//#endregion

// # ========================================================================= #
// # |   Custom Watermark Rendering   |
// # ========================================================================= #

//#region Watermark
f_table_pos(string pos) =>
    switch pos
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        => position.bottom_right

f_text_halign(string pos) =>
    if str.contains(pos, "Left")
        text.align_left
    else if str.contains(pos, "Center")
        text.align_center
    else
        text.align_right

var table wm_tbl = table.new(position = f_table_pos(wm_position), columns = 1, rows = 2, bgcolor = color.new(color.black, 100), frame_color = color.new(color.black, 100), frame_width = 0, border_color = color.new(color.black, 100), border_width = 0)

if wm_show and barstate.islast
    var text_align_val = f_text_halign(wm_position)
    title_text         = wm_bold ? to_bold(wm_title) : wm_title
    sub_text           = (wm_sub_show and wm_bold and wm_subtitle != "") ? to_bold(wm_subtitle) : (wm_sub_show ? wm_subtitle : "")
    
    table.cell(table_id = wm_tbl, column = 0, row = 0, text = title_text, text_color = color.new(wm_title_color, wm_opacity), text_size = f_text_size(wm_title_size), text_halign = text_align_val, text_font_family = f_font_style(wm_font))
    
    if wm_sub_show and wm_subtitle != ""
        table.cell(table_id = wm_tbl, column = 0, row = 1, text = sub_text, text_color = color.new(wm_sub_color, wm_opacity), text_size = f_text_size(wm_sub_size), text_halign = text_align_val, text_font_family = f_font_style(wm_font))
    else
        table.cell(table_id = wm_tbl, column = 0, row = 1, text = "", bgcolor = color.new(color.black, 100))
//#endregion

// # ========================================================================= #
// # |   Modul Asia Range   |
// # ========================================================================= #

//#region Asia Range
// Inisialisasi properti border & background sekali saat startup (Best Practice)
var bool has_border         = i_sess_box_style != 'Background' and i_sess_border_style_raw != border_style_none and i_sess_border_width > 0
var int sess_bw             = has_border ? i_sess_border_width : 0
var color sess_border_color = has_border ? i_sess1_color : color_transparent
var line_style_border       = f_border_style(i_sess_border_style_raw)
var label_position_style    = f_get_label_position(i_label_position_y, i_label_position_s)
var color box_bg            = i_sess_box_background ? color.new(i_sess1_color, i_sess_bgopacity) : color_transparent

// Timeframe Filter: Hanya tampil di bawah timeframe 1H (< 60 menit / 3600 detik)
is_ltf_asia = timeframe.isintraday and timeframe.in_seconds() < 3600
show_asia   = showAsiaRange and i_show_sess1 and is_ltf_asia

// Deteksi Sesi Asia (Default 20:00 - 00:00 New York Time)
t_sess1       = time(timeframe.period, i_sess1, tz)
is_sess1      = not na(t_sess1)
sess1_started = is_sess1 and not is_sess1[1]
sess1_ended   = not is_sess1 and is_sess1[1]

var float sess1_high         = na
var float sess1_low          = na
var box   sess1_current_box   = na
var label sess1_current_label = na
var int   last_sess1_box_bar  = -1

var box[]   sess1_boxes  = array.new_box()
var label[] sess1_labels = array.new_label()

if show_asia
    if sess1_started
        // Pastikan hanya membuat 1 box baru per bar pembuka sesi (aman untuk realtime ticks)
        if last_sess1_box_bar != bar_index
            sess1_high := high
            sess1_low  := low
            last_sess1_box_bar := bar_index

            sess1_current_box := box.new(left=bar_index, top=sess1_high, right=bar_index, bottom=sess1_low,
                                         border_color=sess_border_color, border_width=sess_bw,
                                         border_style=line_style_border, bgcolor=box_bg)
            array.push(sess1_boxes, sess1_current_box)
            if array.size(sess1_boxes) > i_history_period
                box.delete(array.shift(sess1_boxes))

            if i_label_show
                float lbl_y = (i_label_position_y == 'top') ? sess1_high : sess1_low
                string lbl_txt = (not na(i_sess1_label) and i_sess1_label != '') ? format_text_style(i_sess1_label, general_font) : 'Asia'
                sess1_current_label := label.new(x=bar_index, y=lbl_y, text=lbl_txt,
                                                 textcolor=i_sess1_color, color=color_transparent,
                                                 size=f_text_size(i_label_size), style=label_position_style,
                                                 text_font_family=f_font_style(general_font))
                array.push(sess1_labels, sess1_current_label)
                if array.size(sess1_labels) > i_history_period
                    label.delete(array.shift(sess1_labels))
        else
            // Update realtime tick pada candle pembuka yang sama
            sess1_high := math.max(sess1_high, high)
            sess1_low  := math.min(sess1_low, low)
            if not na(sess1_current_box)
                box.set_top(sess1_current_box, sess1_high)
                box.set_bottom(sess1_current_box, sess1_low)
            if not na(sess1_current_label) and i_label_show
                float lbl_y = (i_label_position_y == 'top') ? sess1_high : sess1_low
                label.set_y(sess1_current_label, lbl_y)

    else if is_sess1
        sess1_high := math.max(nz(sess1_high, high), high)
        sess1_low  := math.min(nz(sess1_low, low), low)

        if not na(sess1_current_box)
            box.set_top(sess1_current_box, sess1_high)
            box.set_bottom(sess1_current_box, sess1_low)
            box.set_right(sess1_current_box, bar_index)

        if not na(sess1_current_label) and i_label_show
            float lbl_y = (i_label_position_y == 'top') ? sess1_high : sess1_low
            label.set_y(sess1_current_label, lbl_y)

    else if sess1_ended
        // Finalisasi posisi kanan box tepat pada candle pembuka setelah sesi berakhir (+1 bar) agar seluruh candle sesi terlingkupi utuh
        if not na(sess1_current_box)
            box.set_top(sess1_current_box, sess1_high)
            box.set_bottom(sess1_current_box, sess1_low)
            box.set_right(sess1_current_box, bar_index)
else
    // Jika berada di timeframe >= 1H atau dimatikan, bersihkan semua box/label yang tersisa
    f_clear_boxes(sess1_boxes)
    f_clear_labels(sess1_labels)
    sess1_current_box   := na
    sess1_current_label := na
    last_sess1_box_bar  := -1

// Alerts Asia Range
cross_high = ta.crossover(close, sess1_high)
cross_low  = ta.crossunder(close, sess1_low)

alert_start = show_asia and sess1_started
alert_end   = show_asia and sess1_ended

alertcondition(alert_start, 'Asia Range started', 'Sesi Asia telah dimulai!')
alertcondition(alert_end,   'Asia Range ended',   'Sesi Asia telah berakhir!')
alertcondition(show_asia and not is_sess1 and cross_high, 'Asia Range High crossed (after session closed)', 'Harga menembus Asia Range High!')
alertcondition(show_asia and not is_sess1 and cross_low,  'Asia Range Low crossed (after session closed)',  'Harga menembus Asia Range Low!')
//#endregion

// # ========================================================================= #
// # |   Modul Daily Dividers (Garis Harian)   |
// # ========================================================================= #

//#region Daily Dividers
// Timeframe Filter: Hanya tampil di bawah timeframe 4H (< 240 menit / 14400 detik)
is_ltf_daily_div = timeframe.isintraday and timeframe.in_seconds() < 14400
show_daily_div   = showDailyDividers and is_ltf_daily_div

// Deteksi Awal Hari Baru Berdasarkan Timezone
t_day      = time("D", "", tz)
is_new_day = ta.change(t_day) != 0

var line[]  daily_lines       = array.new_line()
var label[] daily_labels      = array.new_label()
var int     day_start_bar     = na
var float   day_high          = na
var float   day_low           = na
var label   current_day_label = na
var int     last_day_bar      = -1

var line_style_div = f_border_style(daily_div_line_style)
var string dd_lbl_style = (daily_div_label_pos == 'Top') ? label.style_label_down : (daily_div_label_pos == 'Bottom') ? label.style_label_up : label.style_label_center

if show_daily_div
    if is_new_day
        if last_day_bar != bar_index
            last_day_bar := bar_index

            // Finalisasi label hari sebelumnya di tengah rentang hari kemarin
            if not na(current_day_label) and not na(day_start_bar)
                int prev_mid_bar = int(math.round((day_start_bar + bar_index - 1) / 2.0))
                label.set_x(current_day_label, prev_mid_bar)
                float prev_y = (daily_div_label_pos == 'Top') ? day_high : (daily_div_label_pos == 'Bottom') ? day_low : (day_high + day_low) / 2.0
                label.set_y(current_day_label, prev_y)

            // Buat garis vertikal pembatas hari baru
            line new_div_line = line.new(x1 = bar_index, y1 = low, x2 = bar_index, y2 = high,
                                         extend = extend.both, xloc = xloc.bar_index,
                                         color = daily_div_line_color, style = line_style_div,
                                         width = daily_div_line_width)
            array.push(daily_lines, new_div_line)
            if array.size(daily_lines) > daily_div_days
                line.delete(array.shift(daily_lines))

            // Inisialisasi metrik hari baru
            day_start_bar := bar_index
            day_high      := high
            day_low       := low
            int open_hour   = hour(time, tz)
            int ref_time    = open_hour >= 16 ? time + 43200000 : time
            int current_dow = dayofweek(ref_time, tz)

            // Buat label nama hari
            if daily_div_label_show
                string dname = format_text_style(f_day_name(current_dow), general_font)
                float init_y = (daily_div_label_pos == 'Top') ? day_high : (daily_div_label_pos == 'Bottom') ? day_low : (day_high + day_low) / 2.0
                current_day_label := label.new(x = bar_index, y = init_y, text = dname,
                                               xloc = xloc.bar_index, color = color_transparent,
                                               textcolor = daily_div_label_color, size = f_text_size(daily_div_label_size),
                                               style = dd_lbl_style, text_font_family = f_font_style(general_font))
                array.push(daily_labels, current_day_label)
                if array.size(daily_labels) > daily_div_days
                    label.delete(array.shift(daily_labels))
        else
            // Update realtime tick pada candle pembuka hari yang sama
            day_high := math.max(nz(day_high, high), high)
            day_low  := math.min(nz(day_low, low), low)
            if not na(current_day_label) and daily_div_label_show
                float init_y = (daily_div_label_pos == 'Top') ? day_high : (daily_div_label_pos == 'Bottom') ? day_low : (day_high + day_low) / 2.0
                label.set_y(current_day_label, init_y)

    else if not na(day_start_bar)
        // Update pergerakan harga hari ini dan sesuaikan posisi label secara dinamis ke tengah hari
        day_high := math.max(nz(day_high, high), high)
        day_low  := math.min(nz(day_low, low), low)
        if not na(current_day_label) and daily_div_label_show
            int curr_mid_bar = int(math.round((day_start_bar + bar_index) / 2.0))
            label.set_x(current_day_label, curr_mid_bar)
            float curr_y = (daily_div_label_pos == 'Top') ? day_high : (daily_div_label_pos == 'Bottom') ? day_low : (day_high + day_low) / 2.0
            label.set_y(current_day_label, curr_y)
else
    // Bersihkan garis dan label jika timeframe >= 4H atau dimatikan
    f_clear_lines(daily_lines)
    f_clear_labels(daily_labels)
    day_start_bar     := na
    day_high          := na
    day_low           := na
    current_day_label := na
    last_day_bar      := -1
//#endregion
