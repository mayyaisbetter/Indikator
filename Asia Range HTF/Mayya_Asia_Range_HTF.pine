if wm_show and barstate.islast
    var table wm_tbl = table.new(position = f_table_pos(wm_position), columns = 1, rows = 2, bgcolor = wm_bg_color, frame_color = wm_border_color, frame_width = wm_border_width, border_color = wm_border_color, border_width = wm_border_width)
    
    halign = f_text_halign(wm_position)
    title_text = wm_bold ? to_bold(wm_title) : wm_title
    sub_text   = (wm_bold and wm_subtitle != "") ? to_bold(wm_subtitle) : wm_subtitle
    
    table.cell(table_id = wm_tbl, column = 0, row = 0, text = title_text, text_color = color.new(wm_title_color, wm_opacity), text_size = f_text_size(wm_title_size), text_halign = halign, text_font_family = f_font_family(wm_font))
    
    if wm_subtitle != ""
        table.cell(table_id = wm_tbl, column = 0, row = 1, text = sub_text, text_color = color.new(wm_sub_color, wm_opacity), text_size = f_text_size(wm_sub_size), text_halign = halign, text_font_family = f_font_family(wm_font))

