// # ========================================================================= #
// # |   UDTs & Garbage Collector Bin   |
// # ========================================================================= #

//#region UDTs
type UDT_Store
    line     [] bin_ln
    box      [] bin_box
    label    [] bin_lbl
    polyline [] bin_polyline

type UDT_HTF_Candle
    int    num
    int    index
    string tf
    float  o
    float  c
    float  h
    float  l
    int    o_idx
    int    c_idx
    int    h_idx
    int    l_idx
    int    ot
    int    ct
    int    candle_left
    int    candle_right
    float  candle_top
    float  candle_bottom
    int    wick_x 
    int    shift
    bool   is_closed
    bool   bull

var UDT_Store bin = UDT_Store.new(
    bin_ln       = array.new<line>(),
    bin_box      = array.new<box>(),
    bin_lbl      = array.new<label>(),
    bin_polyline = array.new<polyline>()
)

method clean_bin(UDT_Store store) =>
    for obj in store.bin_ln
        obj.delete()
    for obj in store.bin_box
        obj.delete()
    for obj in store.bin_lbl
        obj.delete()
    for obj in store.bin_polyline
        obj.delete()

    store.bin_ln.clear()
    store.bin_box.clear()
    store.bin_lbl.clear()
    store.bin_polyline.clear()

f_clear_boxes(array<box> arr) =>
    for b in arr
        box.delete(b)
    arr.clear()

f_clear_labels(array<label> arr) =>
    for l in arr
        label.delete(l)
    arr.clear()

f_clear_lines(array<line> arr) =>
    for ln in arr
        line.delete(ln)
    arr.clear()
//#endregion

// # ========================================================================= #
// # |   Helper Functions & Styling   |
// # ========================================================================= #

//#region Helpers
f_text_size(string s) =>
    switch str.lower(s)
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        "huge"   => size.huge
        "auto"   => size.auto
        => size.small

f_font_style(string font) =>
    switch font
        'Monospace' => font.family_monospace
        => font.family_default

// Karakter Lookup Efisien (Single-pass parsing per karakter tanpa separator kosong)
var string chars_std_bold = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
var array<string> chars_bold = str.split("𝗮,𝗯,𝗰,𝗱,𝗲,𝗳,𝗴,𝗵,𝗶,𝗷,𝗸,𝗹,𝗺,𝗻,𝗼,𝗽,𝗾,𝗿,𝘀,𝘁,𝘂,𝘃,𝘄,𝘅,𝘆,𝘇,𝗔,𝗕,𝗖,𝗗,𝗘,𝗙,𝗚,𝗛,𝗜,𝗝,𝗞,𝗟,𝗠,𝗡,𝗢,𝗣,𝗤,𝗥,𝗦,𝗧,𝗨,𝗩,𝗪,𝗫,𝗬,𝗭,𝟬,𝟭,𝟮,𝟯,𝟰,𝟱,𝟲,𝟳,𝟴,𝟵", ",")

var string chars_std_sc = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
var array<string> chars_sc = str.split("ᴀ,ʙ,ᴄ,ᴅ,ᴇ,ғ,ɢ,ʜ,ɪ,ᴊ,ᴋ,ʟ,ᴍ,ɴ,ᴏ,ᴘ,ǫ,ʀ,ꜱ,ᴛ,ᴜ,ᴠ,ᴡ,x,ʏ,ᴢ,ᴀ,ʙ,ᴄ,ᴅ,ᴇ,ғ,ɢ,ʜ,ɪ,ᴊ,ᴋ,ʟ,ᴍ,ɴ,ᴏ,ᴘ,ǫ,ʀ,ꜱ,ᴛ,ᴜ,ᴠ,ᴡ,x,ʏ,ᴢ", ",")

f_map_chars(string txt, string from_chars, array<string> to_chars) =>
    int len = str.length(txt)
    string res = ""
    if len > 0
        for i = 0 to len - 1
            string ch = str.substring(txt, i, i + 1)
            int pos = str.pos(from_chars, ch)
            if not na(pos) and pos >= 0 and pos < to_chars.size()
                res += to_chars.get(pos)
            else
                res += ch
    res

to_bold(string txt) =>
    f_map_chars(txt, chars_std_bold, chars_bold)

to_small_caps(string txt) =>
    f_map_chars(txt, chars_std_sc, chars_sc)

format_text_style(string txt, string style) =>
    switch style
        "Bold Modern" => to_bold(txt)
        "Small Caps"  => to_small_caps(txt)
        => txt

candle_size(string size_str) =>
    switch size_str
        'Tiny'   => 2
        'Small'  => 4
        'Medium' => 6
        'Large'  => 8
        'Huge'   => 10
        => 4

tf_label(string tf) =>
    string tfl = tf == '' ? timeframe.period : tf
    switch tfl
        '1'     => '1m'
        '2'     => '2m'
        '3'     => '3m'
        '5'     => '5m'
        '10'    => '10m'
        '15'    => '15m'
        '20'    => '20m'
        '30'    => '30m'
        '45'    => '45m'
        '60'    => '1H'
        '90'    => '90m'
        '120'   => '2H'
        '180'   => '3H'
        '240'   => '4H'
        '360'   => '6H'
        '420'   => '7H'
        '480'   => '8H'
        '540'   => '9H'
        '720'   => '12H'
        'D'     => '1D'
        '1D'    => '1D'
        'W'     => '1W'
        '1W'    => '1W'
        'M'     => '1M'
        '1M'    => '1M'
        '1h'    => '1H'
        '2h'    => '2H'
        '3h'    => '3H'
        '4h'    => '4H'
        '6h'    => '6H'
        '7h'    => '7H'
        '8h'    => '8H'
        '9h'    => '9H'
        '12h'   => '12H'
        => tfl

format_countdown(int remaining_ms) =>
    if remaining_ms <= 0
        "00:00"
    else
        int total_seconds = int(math.ceil(remaining_ms / 1000.0))
        int days          = int(math.floor(total_seconds / 86400))
        int hours         = int(math.floor((total_seconds % 86400) / 3600))
        int minutes       = int(math.floor((total_seconds % 3600) / 60))
        int seconds       = total_seconds % 60
        if days > 0
            str.format("{0}d {1}h", days, hours)
        else if hours > 0
            str.format("{0,number,00}:{1,number,00}:{2,number,00}", hours, minutes, seconds)
        else
            str.format("{0,number,00}:{1,number,00}", minutes, seconds)

f_day_name(int dow) =>
    switch dow
        dayofweek.sunday    => "Sunday"
        dayofweek.monday    => "Monday"
        dayofweek.tuesday   => "Tuesday"
        dayofweek.wednesday => "Wednesday"
        dayofweek.thursday  => "Thursday"
        dayofweek.friday    => "Friday"
        dayofweek.saturday  => "Saturday"
        => ""

session_begins(string tf, string ses, string timezone_val) =>
    ta.change(time(tf, ses, na(timezone_val) ? "" : timezone_val)) != 0

in_session(string tf, string ses, string timezone_val) =>
    t  = time(tf, ses, na(timezone_val) ? "" : timezone_val)
    ct = time_close(tf, ses, na(timezone_val) ? "" : timezone_val)
    not na(t) and not na(ct)

is_bullish_candle(float c, float o, float h, float l) =>
    c == o ? math.abs(o - h) < math.abs(o - l) : c > o

f_border_style(string _style) =>
    switch _style
        border_style_solid  => line.style_solid
        border_style_dashed => line.style_dashed
        border_style_dotted => line.style_dotted
        => line.style_dashed

f_get_label_position(string _y, string _side) =>
    switch _y
        'top'    => _side == 'outside' ? label.style_label_lower_left : label.style_label_upper_left
        'bottom' => _side == 'outside' ? label.style_label_upper_left : label.style_label_lower_left
        => label.style_label_lower_left

f_parse_tz(string tz_str) =>
    switch tz_str
        'Exchange'              => syminfo.timezone
        '(UTC-10) Honolulu'     => 'Pacific/Honolulu'
        '(UTC-8) Anchorage'     => 'America/Anchorage'
        '(UTC-8) Juneau'        => 'America/Juneau'
        '(UTC-7) Los Angeles'   => 'America/Los_Angeles'
        '(UTC-7) Phoenix'       => 'America/Phoenix'
        '(UTC-7) Vancouver'     => 'America/Vancouver'
        '(UTC-6) Denver'        => 'America/Denver'
        '(UTC-6) Mexico City'   => 'America/Mexico_City'
        '(UTC-6) San Salvador'  => 'America/El_Salvador'
        '(UTC-5) Bogota'        => 'America/Bogota'
        '(UTC-5) Chicago'       => 'America/Chicago'
        '(UTC-5) Lima'          => 'America/Lima'
        '(UTC-4) Caracas'       => 'America/Caracas'
        '(UTC-4) New York'      => 'America/New_York'
        '(UTC-4) Toronto'       => 'America/Toronto'
        '(UTC-3) Buenos Aires'  => 'America/Argentina/Buenos_Aires'
        '(UTC-3) Halifax'       => 'America/Halifax'
