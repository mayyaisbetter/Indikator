    res := str.replace_all(res, "J", "ᴊ")
    res := str.replace_all(res, "j", "ᴊ")
    res := str.replace_all(res, "K", "ᴋ")
    res := str.replace_all(res, "k", "ᴋ")
    res := str.replace_all(res, "L", "ʟ")
    res := str.replace_all(res, "l", "ʟ")
