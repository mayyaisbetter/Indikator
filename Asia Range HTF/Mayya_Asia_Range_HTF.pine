htf_1_tf                = input.timeframe("60", "", inline = "htf1", group = g_htf)
htf_1_number            = input.int(6, "", minval = 1, maxval = 30, inline = "htf1", group = g_htf)
htf_1_map               = input.bool(true, "Trace LTF", inline = "htf1", group = g_htf, tooltip = "Petakan level HTF 1 ke chart LTF")

