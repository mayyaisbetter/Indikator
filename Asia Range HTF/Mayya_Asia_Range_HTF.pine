//#endregion

// # ========================================================================= #
// # |   UDTs & Storage Management                                           |
// # ========================================================================= #

//#region UDTs & Memory Bin

type UDT_Store
    line[]  lines
    box[]   boxes
    label[] labels

var UDT_Store bin = UDT_Store.new(array.new<line>(), array.new<box>(), array.new<label>())

method clean_bin(UDT_Store store) =>
    for l in store.lines
        l.delete()
    for b in store.boxes
        b.delete()
    for lbl in store.labels
        lbl.delete()
    store.lines.clear()
    store.boxes.clear()
    store.labels.clear()

type UDT_AsiaSession
    int   start_bar = na
    int   end_bar = na
    float hi = na
    float lo = na
    float mid = na
    box   sess_box = na
    line  hi_line = na
    line  lo_line = na
    line  mid_line = na
    bool  hi_swept = false
    bool  lo_swept = false

var array<UDT_AsiaSession> asia_sessions = array.new<UDT_AsiaSession>()

type UDT_HTFCandle
    string tf = ""
    float  o = na
    float  c = na
    float  h = na
    float  l = na
    int    ot = na
    int    ct = na
    int    o_idx = na
    int    c_idx = na
    int    h_idx = na
    int    l_idx = na
    int    candle_left = na
    int    candle_right = na
    float  candle_top = na
    float  candle_bottom = na
    int    wick_x = na
    bool   is_closed = false
    bool   bull = false

var array<UDT_HTFCandle> htf_1_list = array.new<UDT_HTFCandle>()
var array<UDT_HTFCandle> htf_2_list = array.new<UDT_HTFCandle>()
var array<UDT_HTFCandle> htf_3_list = array.new<UDT_HTFCandle>()

//#endregion

// # ========================================================================= #
// # |   Modul 1: Asia Range Logic                                           |
// # ========================================================================= #

//#region Asia Range Execution

var int   asia_start_bar = na
var float current_asia_hi = na
var float current_asia_lo = na

// Helper session functions
is_in_asia = not na(time(timeframe.period, asia_session, asia_tz))
asia_started = is_in_asia and not is_in_asia[1]
asia_ended   = not is_in_asia and is_in_asia[1]

if show_asia
    if asia_started
        asia_start_bar := bar_index
        current_asia_hi := high
        current_asia_lo := low
        
        // Buat objek sesi baru
        UDT_AsiaSession new_sess = UDT_AsiaSession.new(start_bar = bar_index, end_bar = bar_index, hi = high, lo = low, mid = (high + low) / 2)
        new_sess.sess_box := box.new(left = bar_index, top = high, right = bar_index + 1, bottom = low, border_color = asia_border_col, bgcolor = asia_box_col, border_width = 1)
        asia_sessions.push(new_sess)
        
        // Jaga kapasitas array history
        if asia_sessions.size() > asia_history_count
            UDT_AsiaSession oldest = asia_sessions.shift()
            if not na(oldest.sess_box)
                oldest.sess_box.delete()
            if not na(oldest.hi_line)
                oldest.hi_line.delete()
            if not na(oldest.lo_line)
                oldest.lo_line.delete()
            if not na(oldest.mid_line)
                oldest.mid_line.delete()

    else if is_in_asia and asia_sessions.size() > 0
        current_asia_hi := math.max(current_asia_hi, high)
        current_asia_lo := math.min(current_asia_lo, low)
        
        UDT_AsiaSession latest = asia_sessions.get(asia_sessions.size() - 1)
        latest.end_bar := bar_index
        latest.hi := current_asia_hi
        latest.lo := current_asia_lo
        latest.mid := (current_asia_hi + current_asia_lo) / 2
        
        if not na(latest.sess_box)
            box.set_top(latest.sess_box, current_asia_hi)
            box.set_bottom(latest.sess_box, current_asia_lo)
            box.set_right(latest.sess_box, bar_index)

    else if asia_ended and asia_sessions.size() > 0
        UDT_AsiaSession latest = asia_sessions.get(asia_sessions.size() - 1)
        latest.end_bar := bar_index
        
        ext_target = bar_index + asia_extend_bars
        if asia_show_hl
            latest.hi_line := line.new(x1 = latest.start_bar, y1 = latest.hi, x2 = ext_target, y2 = latest.hi, color = asia_hi_col, width = 1, style = line.style_solid)
            latest.lo_line := line.new(x1 = latest.start_bar, y1 = latest.lo, x2 = ext_target, y2 = latest.lo, color = asia_lo_col, width = 1, style = line.style_solid)
            
            // Label High / Low
            label.new(x = ext_target, y = latest.hi, text = "Asia High (" + str.tostring(latest.hi, format.mintick) + ")", style = label.style_label_left, textcolor = asia_hi_col, color = #ffffff00, size = size.tiny)
            label.new(x = ext_target, y = latest.lo, text = "Asia Low (" + str.tostring(latest.lo, format.mintick) + ")", style = label.style_label_left, textcolor = asia_lo_col, color = #ffffff00, size = size.tiny)
        
        if asia_show_eq
            latest.mid_line := line.new(x1 = latest.start_bar, y1 = latest.mid, x2 = ext_target, y2 = latest.mid, color = asia_eq_col, width = 1, style = line.style_dotted)
            label.new(x = ext_target, y = latest.mid, text = "Asia EQ 50%", style = label.style_label_left, textcolor = color.gray, color = #ffffff00, size = size.tiny)

    // Deteksi Liquidity Sweeps setelah sesi Asia selesai
    if not is_in_asia and asia_detect_sweep and asia_sessions.size() > 0
        UDT_AsiaSession latest = asia_sessions.get(asia_sessions.size() - 1)
        if not latest.hi_swept and high > latest.hi
            latest.hi_swept := true
            label.new(x = bar_index, y = high, text = "⚡ Asia High Swept", style = label.style_label_down, color = color.new(asia_hi_col, 20), textcolor = color.black, size = size.small)
            alert("Asia High Liquidity Swept pada " + syminfo.ticker, alert.freq_once_per_bar)

        if not latest.lo_swept and low < latest.lo
            latest.lo_swept := true
            label.new(x = bar_index, y = low, text = "⚡ Asia Low Swept", style = label.style_label_up, color = color.new(asia_lo_col, 20), textcolor = color.white, size = size.small)
            alert("Asia Low Liquidity Swept pada " + syminfo.ticker, alert.freq_once_per_bar)

//#endregion

// # ========================================================================= #
// # |   Modul 2: HTF Candles Reconstruction & Plotting                      |
// # ========================================================================= #

//#region HTF Candles Engine

method detect_candle(array<UDT_HTFCandle> list, string tf) =>
    bool is_new_session = ta.change(time(tf, "")) != 0 or list.size() == 0
    if is_new_session
        if list.size() > 0
            UDT_HTFCandle last_c = list.get(0)
            last_c.is_closed := true
            last_c.ct := time
        UDT_HTFCandle c = UDT_HTFCandle.new(
             tf = tf,
             o = open,
             h = high,
             l = low,
             c = close,
             ot = time,
             ct = time,
             o_idx = bar_index,
             c_idx = bar_index,
             h_idx = bar_index,
             l_idx = bar_index,
             bull = close >= open
         )
        list.unshift(c)

    if not is_new_session and list.size() > 0
        UDT_HTFCandle c = list.get(0)
        c.c := close
        c.c_idx := bar_index
        c.ct := time
        if high > c.h
            c.h := high
            c.h_idx := bar_index
        if low < c.l
            c.l := low
            c.l_idx := bar_index
        c.bull := c.c >= c.o
    list

method trim_list(array<UDT_HTFCandle> list, int max_count) =>
    while list.size() > max_count
        list.pop()
    list

tf_format(string tf) =>
    switch tf
        "1"   => "1m"
        "3"   => "3m"
        "5"   => "5m"
        "15"  => "15m"
        "30"  => "30m"
        "45"  => "45m"
        "60"  => "1H"
        "120" => "2H"
        "180" => "3H"
        "240" => "4H"
        "D"   => "1D"
        "1D"  => "1D"
        "W"   => "1W"
        "1W"  => "1W"
        "M"   => "1M"
        "1M"  => "1M"
        => tf

format_countdown(int remaining_ms) =>
    if remaining_ms <= 0
        "00:00"
    else
        total_seconds = math.floor(remaining_ms / 1000)
        days = math.floor(total_seconds / 86400)
        hours = math.floor((total_seconds % 86400) / 3600)
        minutes = math.floor((total_seconds % 3600) / 60)
        seconds = total_seconds % 60
        if days > 0
            str.format("{0}d {1}h", days, hours)
        else if hours > 0
            str.format("{0,number,00}:{1,number,00}:{2,number,00}", hours, minutes, seconds)
        else
            str.format("{0,number,00}:{1,number,00}", minutes, seconds)

method draw_htf_candles(array<UDT_HTFCandle> list, int base_offset, string tf, bool trace_ltf) =>
    count = list.size()
    if count > 0
        float y_high = na
        float y_low  = na
        for i = 0 to count - 1
            UDT_HTFCandle candle = list.get(i)
            // Hitung koordinat offset visual di sisi kanan chart
            shift = base_offset + (htf_candle_width + htf_candle_space) * (count - i - 1)
            candle.candle_left  := last_bar_index + shift
            candle.candle_right := candle.candle_left + htf_candle_width
            candle.candle_top   := math.max(candle.o, candle.c)
            candle.candle_bottom:= math.min(candle.o, candle.c)
            candle.wick_x       := candle.candle_left + math.round(htf_candle_width / 2)
            
            y_high := na(y_high) ? candle.h : math.max(y_high, candle.h)
            y_low  := na(y_low)  ? candle.l : math.min(y_low, candle.l)
            
            c_color = candle.bull ? htf_bull_color : htf_bear_color
            
            // Gambar body candle
            bin.boxes.push(box.new(left = candle.candle_left, top = candle.candle_top, right = candle.candle_right, bottom = candle.candle_bottom, border_color = htf_wick_color, bgcolor = c_color))
            // Gambar wick atas dan bawah
            bin.lines.push(line.new(x1 = candle.wick_x, y1 = candle.h, x2 = candle.wick_x, y2 = candle.candle_top, color = htf_wick_color, width = 1))
            bin.lines.push(line.new(x1 = candle.wick_x, y1 = candle.candle_bottom, x2 = candle.wick_x, y2 = candle.l, color = htf_wick_color, width = 1))
            
            // Garis trace High/Low ke chart saat ini (opsional)
            if trace_ltf and htf_trace_hl_show and i == 0
                bin.lines.push(line.new(x1 = candle.ot, y1 = candle.h, x2 = time, y2 = candle.h, xloc = xloc.bar_time, color = htf_trace_hl_color, style = line.style_dotted))
                bin.lines.push(line.new(x1 = candle.ot, y1 = candle.l, x2 = time, y2 = candle.l, xloc = xloc.bar_time, color = htf_trace_hl_color, style = line.style_dotted))

        // Center label offset
        mid_shift = base_offset + (htf_candle_width + htf_candle_space) * math.round(count / 2)
        
        // Buat string judul & hitung mundur candle close
        title_txt = tf_format(tf)
        if htf_countdown_show
            tc = time_close(tf, "")
            if not na(tc)
                rem_ms = math.max(0, tc - timenow)
                title_txt := title_txt + "\n" + format_countdown(rem_ms)

        // Render label berdasarkan pilihan posisi: Top, Bottom, atau Both
        if htf_title_position == "Top" or htf_title_position == "Both"
            bin.labels.push(label.new(x = last_bar_index + mid_shift, y = y_high, text = title_txt, style = label.style_label_down, textcolor = htf_title_color, color = #ffffff00, size = size.tiny))
            
        if htf_title_position == "Bottom" or htf_title_position == "Both"
            bin.labels.push(label.new(x = last_bar_index + mid_shift, y = y_low, text = title_txt, style = label.style_label_up, textcolor = htf_title_color, color = #ffffff00, size = size.tiny))

//#endregion

// # ========================================================================= #
// # |   Execution & Rendering Loop                                          |
// # ========================================================================= #

//#region Main Execution

var bool tf1_valid = htf_1_show and timeframe.in_seconds(timeframe.period) < timeframe.in_seconds(htf_1_tf)
var bool tf2_valid = htf_2_show and timeframe.in_seconds(timeframe.period) < timeframe.in_seconds(htf_2_tf)
var bool tf3_valid = htf_3_show and timeframe.in_seconds(timeframe.period) < timeframe.in_seconds(htf_3_tf)

if show_htf
    if tf1_valid
        htf_1_list.detect_candle(htf_1_tf)
        htf_1_list.trim_list(htf_1_number)

    if tf2_valid
        htf_2_list.detect_candle(htf_2_tf)
        htf_2_list.trim_list(htf_2_number)

    if tf3_valid
        htf_3_list.detect_candle(htf_3_tf)
        htf_3_list.trim_list(htf_3_number)

    if barstate.islast
        bin.clean_bin()
        cur_offset = htf_candle_offset
        
        if tf1_valid
            htf_1_list.draw_htf_candles(cur_offset, htf_1_tf, htf_1_map)
            cur_offset += (htf_candle_width + htf_candle_space) * htf_1_number + 6
            
        if tf2_valid
            htf_2_list.draw_htf_candles(cur_offset, htf_2_tf, htf_2_map)
            cur_offset += (htf_candle_width + htf_candle_space) * htf_2_number + 6
            
        if tf3_valid
            htf_3_list.draw_htf_candles(cur_offset, htf_3_tf, htf_3_map)
else
    bin.clean_bin()

//#endregion

// # ========================================================================= #
// # |   Modul 3: Custom Watermark Rendering                                 |
// # ========================================================================= #

//#region Watermark Helpers & Execution

f_table_pos(string pos) =>
    switch pos
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        => position.bottom_right

f_text_halign(string pos) =>
    if str.contains(pos, "Left")
        text.align_left
    else if str.contains(pos, "Center")
        text.align_center
    else
        text.align_right

f_text_size(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.normal

f_font_family(string f) =>
    switch f
        "Default"   => font.family_default
        "Monospace" => font.family_monospace
        => font.family_default

to_bold(string txt) =>
    string res = txt
    res := str.replace_all(res, "a", "𝗮")
    res := str.replace_all(res, "b", "𝗯")
    res := str.replace_all(res, "c", "𝗰")
    res := str.replace_all(res, "d", "𝗱")
    res := str.replace_all(res, "e", "𝗲")
    res := str.replace_all(res, "f", "𝗳")
    res := str.replace_all(res, "g", "𝗴")
    res := str.replace_all(res, "h", "𝗵")
    res := str.replace_all(res, "i", "𝗶")
    res := str.replace_all(res, "j", "𝗷")
    res := str.replace_all(res, "k", "𝗸")
    res := str.replace_all(res, "l", "𝗹")
    res := str.replace_all(res, "m", "𝗺")
    res := str.replace_all(res, "n", "𝗻")
