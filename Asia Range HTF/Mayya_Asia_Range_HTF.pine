wm_sub_size             = input.string("Small", "Ukuran Subtitle", options = ["Tiny", "Small", "Normal", "Large", "Huge"], inline = "wm_sz", group = g_wm)
wm_title_color          = input.color(#00E676, "Warna Title", inline = "wm_col", group = g_wm)
wm_sub_color            = input.color(color.gray, "Warna Subtitle", inline = "wm_col", group = g_wm)
wm_opacity              = input.int(20, "Transparansi Teks (%)", minval = 0, maxval = 90, group = g_wm, tooltip = "0% = sangat pekat/tebal, 90% = sangat transparan")
