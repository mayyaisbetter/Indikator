    res := str.replace_all(res, "m", "ᴍ")
    res := str.replace_all(res, "N", "ɴ")
    res := str.replace_all(res, "n", "ɴ")
    res := str.replace_all(res, "O", "ᴏ")
    res := str.replace_all(res, "o", "ᴏ")
