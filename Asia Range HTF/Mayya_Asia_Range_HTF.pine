wm_title                = input.string("Mayya Trading", "Title Watermark", group = g_wm)
wm_subtitle             = input.string("Asia Range & HTF Model", "Subtitle Watermark", group = g_wm)
wm_position             = input.string("Bottom Right", "Posisi Watermark", options = ["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group = g_wm, tooltip = "Atur penempatan watermark: Atas, Bawah, Kiri, Kanan, atau Tengah")
wm_font                 = input.string("Default", "Gaya Font", options = ["Default", "Monospace"], group = g_wm)
wm_bold                 = input.bool(true, "Teks Tebal (Bold)", group = g_wm, tooltip = "Mengubah karakter teks menjadi tebal (Bold Mathematical Unicode)")
