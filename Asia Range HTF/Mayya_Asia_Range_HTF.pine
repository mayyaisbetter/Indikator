asia_tz                 = input.string("GMT+0", "Timezone", options = ["GMT-11", "GMT-10", "GMT-9", "GMT-8", "GMT-7", "GMT-6", "GMT-5", "GMT-4", "GMT-3", "GMT-2", "GMT-1", "GMT+0", "GMT+1", "GMT+2", "GMT+3", "GMT+4", "GMT+5", "GMT+6", "GMT+7", "GMT+8", "GMT+9", "GMT+10", "GMT+11", "GMT+12"], group = g_asia)
asia_box_col            = input.color(color.new(#2962FF, 90), "Warna Box Asia", group = g_asia)
asia_border_col         = input.color(#2962FF, "Warna Border Box", group = g_asia)
asia_show_hl            = input.bool(true, "Garis High & Low Asia", group = g_asia)
asia_hi_col             = input.color(#00E676, "Warna Asia High", inline = "hl_col", group = g_asia)
