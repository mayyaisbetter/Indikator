// # Helper: Map TF Input to Resolution ------------------------------------- #
f_tf_to_res(string tf_str) =>
    switch tf_str
        '15m' => '15'
        '30m' => '30'
        '45m' => '45'
        '1h'  => '60'
        '90m' => '90'
        '2h'  => '120'
        '3h'  => '180'
        '4h'  => '240'
        '6h'  => '360'
        '7h'  => '420'
        '8h'  => '480'
        '9h'  => '540'
        '12h' => '720'
        => tf_str

